{
  "name": "cresslet-container",
  "version": "0.1.0",
  "description": "In-browser runtime: VFS, shell, npm, node-ish workers, dev server, builds.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/cresslet-container.js",
  "module": "./dist/cresslet-container.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/cresslet-container.js"
    },
    "./cresslet-sw.js": "./dist/cresslet-sw.js",
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "repository": "github:ODumpling/cresslet-container",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "buffer": "6.0.3",
    "cjs-module-lexer": "^2.3.0",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "0.28.2",
    "events": "3.3.0",
    "readable-stream": "4.7.0",
    "semver": "^7.8.6",
    "string_decoder": "1.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "demo": "node scripts/serve.mjs",
    "test:e2e:all": "playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
