{
  "name": "cresslet-container",
  "version": "0.1.0",
  "description": "In-browser runtime: VFS, shell, npm, node-ish workers, dev server, builds.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/cresslet-container.js",
  "module": "./dist/cresslet-container.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/cresslet-container.js"
    },
    "./cresslet-sw.js": "./dist/cresslet-sw.js",
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "repository": "github:ODumpling/cresslet-container",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@prefresh/core": "1.5.11",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "autoprefixer": "^10.7.0",
    "brotli-wasm": "3.0.1",
    "buffer": "6.0.3",
    "cjs-module-lexer": "^2.3.0",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "0.28.2",
    "events": "3.3.0",
    "fake-indexeddb": "6.2.7",
    "less": "^4.9.1",
    "postcss": "^8.5.33",
    "pug": "3.0.3",
    "react-refresh": "0.19.0",
    "readable-stream": "4.7.0",
    "sass": "^1.108.2",
    "semver": "^7.8.6",
    "string_decoder": "1.3.0",
    "svelte": "5.59.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1",
    "vue": "3.5.46"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json && tsc -p tsconfig.js.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "demo": "node scripts/serve.ts",
    "test:e2e:all": "playwright test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
